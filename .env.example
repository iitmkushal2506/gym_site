# ==============================================================================
# IRONFORGE FITNESS - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Core Application
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database (PostgreSQL for Production, or leave blank for SQLite local fallback)
# Example PostgreSQL: postgresql://username:password@localhost:5432/ironforge_db
DATABASE_URL=

# Email & SMTP Settings (Optional in dev; fallback simulation logger active)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=notifications@ironforgefitness.com
ADMIN_NOTIFICATION_EMAIL=admin@ironforgefitness.com

# Gym Brand Details
GYM_NAME="IRONFORGE FITNESS"
GYM_TAGLINE="BUILD STRONGER. LIVE STRONGER."
GYM_PHONE="+91 98765 43210"
GYM_EMAIL="info@ironforgefitness.com"
GYM_ADDRESS="42 Titan Avenue, Platinum Heights, Metro City, 560001"
GYM_WHATSAPP="919876543210"
GYM_INSTAGRAM="https://instagram.com/ironforgefitness"

# Google Analytics (Optional)
GA_TRACKING_ID=
