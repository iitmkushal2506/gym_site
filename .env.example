# ==============================================================================
# KUSHAL'S GYM SITE - ENVIRONMENT VARIABLES CONFIGURATION
# Portfolio Showcase & Production Deployment
# ==============================================================================

# Core Application
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database (PostgreSQL for Production, or leave blank for SQLite local fallback)
# Example PostgreSQL: postgresql://username:password@localhost:5432/kushalgym_db
DATABASE_URL=

# Email & SMTP Settings (Optional in dev; fallback simulation logger active)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=notifications@kushalgym.demo
ADMIN_NOTIFICATION_EMAIL=admin@kushalgym.demo

# Gym Brand Details (Customizable for each client pitch)
GYM_NAME="KUSHAL'S GYM SITE"
GYM_TAGLINE="BUILD STRONGER. LIVE STRONGER."
GYM_PHONE="+91 98XXX XXXXX"
GYM_EMAIL="contact@kushalgym.demo"
GYM_ADDRESS="123 Fitness Boulevard, Sector XX, Metro City, 000000"
GYM_WHATSAPP="9198XXXXXXXX"
GYM_INSTAGRAM="https://instagram.com/yourgymhandle"

# Google Analytics (Optional)
GA_TRACKING_ID=
